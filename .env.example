APP_ENV=production
HOST=0.0.0.0
PORT=8090

MONITOR_INTERVAL_MS=1000

RESTREAMER_BASE_URL=http://restreamer:8080
# Optional full UI endpoint. If empty, Supervisor probes RESTREAMER_BASE_URL/ui/.
RESTREAMER_UI_URL=
RESTREAMER_USERNAME=admin
RESTREAMER_PASSWORD=

# Comma-separated exact Docker container names observed by the isolated helper.
DOCKER_MONITOR_CONTAINERS=restreamer,stream-supervisor

# Admin account. Historical names kept for backward compatibility.
# Required before any write action is enabled.
SUPERVISOR_USERNAME=
SUPERVISOR_PASSWORD=

# Optional Technician account. Technician can start/stop existing destinations.
SUPERVISOR_TECH_USERNAME=
SUPERVISOR_TECH_PASSWORD=

# Graduated watchdog. Observe is the safe default and never writes to Restreamer.
WATCHDOG_MODE=observe
# Requires WATCHDOG_MODE=recover as well. Only failed egress outputs with LIVE ingest are eligible.
WATCHDOG_OUTPUT_RECOVERY=false
WATCHDOG_OUTPUT_ERROR_THRESHOLD_MS=20000
WATCHDOG_VERIFY_AFTER_MS=10000
WATCHDOG_COOLDOWN_MS=300000
WATCHDOG_MAX_ATTEMPTS=1
WATCHDOG_ATTEMPT_WINDOW_MS=900000
