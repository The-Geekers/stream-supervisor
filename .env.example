APP_ENV=production
HOST=0.0.0.0
PORT=8090

MONITOR_INTERVAL_MS=1000

RESTREAMER_BASE_URL=http://host.docker.internal:8080
# Optional UI endpoint. If empty, Supervisor also probes the HTTPS listener on 8181.
RESTREAMER_UI_URL=
RESTREAMER_USERNAME=admin
RESTREAMER_PASSWORD=

# Comma-separated exact Docker container names observed by the isolated helper.
DOCKER_MONITOR_CONTAINERS=restreamer,stream-supervisor

SUPERVISOR_USERNAME=
SUPERVISOR_PASSWORD=
