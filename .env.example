APP_ENV=production
HOST=0.0.0.0
PORT=8090

# Shared Restreamer source polling interval.
# The browser receives updates over SSE. 1000 ms = near-realtime without
# multiplying Core requests when several operators have the UI open.
MONITOR_INTERVAL_MS=1000

# Runtime-only Restreamer credentials.
# Copy this file to .env on the VPS and put the real values there.
# .env is ignored by Git and must NEVER be committed.
RESTREAMER_BASE_URL=http://host.docker.internal:8080
# Optional override. If omitted, Supervisor derives port 8181 from the Core URL.
RESTREAMER_UI_URL=http://host.docker.internal:8181
RESTREAMER_USERNAME=admin
RESTREAMER_PASSWORD=

# Optional HTTP Basic authentication for Supervisor.
# When both values are non-empty, every UI/API route except /health is protected.
SUPERVISOR_USERNAME=
SUPERVISOR_PASSWORD=
